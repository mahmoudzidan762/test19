<odoo>

    <record id="view_ipc_list" model="ir.ui.view">
        <field name="name">ipc.certificate.list</field>
        <field name="model">ipc.certificate</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="lead_id" string="Project Name"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ipc_form" model="ir.ui.view">
        <field name="name">ipc.certificate.form</field>
        <field name="model">ipc.certificate</field>
        <field name="arch" type="xml">
            <form string="Interim Payment Certificate">

                <!-- HEADER -->
                <header>

                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>

                    <button name="action_invoice" string="Invoice" type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"/>

                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-danger"
                            invisible="state not in ('draft','confirmed','approved')"/>

                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('confirmed','approved','invoiced','cancelled')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,approved,invoiced,cancelled"/>

                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="boq_id"/>
                            <field name="lead_id" string="Project Name"/>
                            <field name="partner_id"/>
                            <field name="project_manager_id"/>
                        </group>

                        <group>
                            <field name="st_date"/>
                            <field name="end_date"/>
                            <field name="date_duration"/>
                            <field name="analytic_account_id"/>
                        </group>
                    </group>

                    <group>
                        <field name="invoice_date"/>
                    </group>

                    <!-- NOTEBOOK -->
                    <notebook>

                        <!-- WORK ITEMS -->
                        <page string="Work Items">
                            <button name="action_add_boq_line" string="Add BOQ Line" type="object"
                                    class="oe_highlight"/>
                            <field name="line_ids">
                                <list editable="bottom" create="False">
                                    <field name="items" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="qty" readonly="1"/>
                                    <field name="new_variation_qty" readonly="1"/>
                                    <field name="total_previous" readonly="1"/>
                                    <field name="total_current"/>
                                    <field name="total_cumulative"/>
                                    <field name="remaining"/>
                                    <field name="onsite_amount"/>
                                    <field name="onsite_progress" widget="percentage"/>
                                    <field name="unit_price"/>
                                    <field name="ipc_total"/>
                                </list>
                            </field>
                            <div class="d-flex justify-content-end mt-2">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="fw-bold text-muted">Gross Work Value:</span>
                                    <field name="total_ipc_amount" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </page>

                        <!-- ACCOUNTING -->
                        <page string="Accounting">
                            <group string="A - Retention">
                                <group>
                                    <field name="retention_percentage" widget="percentage" readonly="1"/>
                                    <field name="retention_previous"/>
                                    <field name="retention_current"/>
                                </group>

                                <group>
                                    <field name="retention_journal" readonly="1"/>
                                    <field name="retention_account"/>
                                    <field name="retention_cumulative"/>
                                </group>
                            </group>

                            <group string="B - Advance Recovery">
                                <group>
                                    <field name="advance_percentage" readonly="1" widget="percentage"/>
                                    <field name="advance_total_amount" readonly="1"/>
                                    <field name="advance_recovered_before"/>
                                    <field name="advance_recovery_current"/>
                                </group>

                                <group>
                                    <field name="advance_recovery_cumulative"/>
                                    <field name="remaining_advance_balance"/>
                                    <field name="advance_journal" readonly="1"/>
                                    <field name="advance_account"/>
                                </group>
                            </group>

                            <group string="C - Other Deductions">
                                <group>
                                    <field name="penalty_percentage" widget="percentage"/>
                                    <field name="penalty_amount"/>
                                    <field name="other_deduction_percentage" widget="percentage"/>
                                    <field name="other_deduction_amount"/>
                                </group>

                                <group>
                                    <field name="penalty_journal"/>
                                    <field name="remarks"/>
                                    <field name="penalty_account"/>
                                    <field name="deduction_account"/>
                                </group>
                            </group>
                        </page>

                        <!-- SUMMARY -->
                        <page string="Summary" name="summary_page">
                            <div style="padding: 24px 20px;">

                                <!-- ROW 1: WORK SUMMARY + FINAL SUMMARY -->
                                <div class="row g-4 mb-4">

                                    <!-- WORK SUMMARY -->
                                    <div class="col-lg-6 col-md-12">
                                        <div style="border-top: 2px solid #dee2e6; padding-top: 12px;">
                                            <p style="font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #868e96; margin-bottom: 16px;">
                                                Work Summary
                                            </p>
                                            <group col="2">
                                                <field name="previous_ipc_amount"
                                                       string="Previous IPC Amount"/>
                                                <field name="total_ipc_amount"/>
                                            </group>
                                        </div>
                                    </div>

                                    <!-- FINAL SUMMARY -->
                                    <div class="col-lg-6 col-md-12">
                                        <div style="border-top: 2px solid #dee2e6; padding-top: 12px;">
                                            <p style="font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #868e96; margin-bottom: 16px;">
                                                Final Summary
                                            </p>
                                            <group col="2">
                                                <field name="net_before_tax"
                                                       string="Net Before Tax"/>
                                                <field name="tax_percentage"
                                                       string="Tax %"
                                                       widget="percentage"
                                                       readonly="1"/>
                                                <field name="tax_amount"
                                                       string="Tax Amount"
                                                       readonly="1"/>
                                                <field name="final_net_amount"
                                                       string="Final Net Amount"
                                                       readonly="1"
                                                       class="fw-bold"/>
                                            </group>
                                        </div>
                                    </div>

                                </div>

                                <!-- ROW 2: DEDUCTIONS -->
                                <div class="row">
                                    <div class="col-12">
                                        <div style="border-top: 2px solid #dee2e6; padding-top: 12px;">
                                            <p style="font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #868e96; margin-bottom: 16px;">
                                                Deductions
                                            </p>
                                            <div class="row">
                                                <div class="col-lg-6 col-md-12">
                                                    <group col="2" class="o_group_deductions">
                                                        <field name="retention_current"
                                                               string="Retention Current"
                                                               class="text-danger"/>
                                                        <field name="advance_recovery_current"
                                                               string="Advance Recovery"
                                                               readonly="1"
                                                               class="text-danger"/>
                                                        <field name="penalty_amount"
                                                               string="Penalty Amount"
                                                               class="text-danger"/>
                                                        <field name="other_deduction_amount"
                                                               string="Other Deductions"
                                                               class="text-danger"/>
                                                    </group>
                                                </div>
                                                <div class="col-lg-6 col-md-12">
                                                    <div style="border-top: 1px solid #dee2e6; margin-top: 8px; padding-top: 12px;">
                                                        <group col="2">
                                                            <field name="total_deductions"
                                                                   string="Total Deductions"
                                                                   class="fw-bold text-danger"/>
                                                        </group>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </page>

                        <!-- NOTES -->
                        <page string="Notes / Attachments">
                            <field name="notes" placeholder="Internal notes here..."/>
                            <field name="attachments" widget="html" placeholder="Click / For Uploading..."/>
                        </page>

                    </notebook>

                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="action_ipc" model="ir.actions.act_window">
        <field name="name">IPCs</field>
        <field name="res_model">ipc.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>