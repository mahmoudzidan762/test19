<odoo>
    <record id="project_payment_request_wizard_form_view" model="ir.ui.view">
        <field name="name">project.payment.request.wizard.form.view</field>
        <field name="model">project.payment.request</field>
        <field name="arch" type="xml">
            <form string="Project Payment Request">
                <group>
                    <group>
                        <field name="payment_for"/>
                        <field name="journal_id"/>
                        <field name="bid_file_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="amount"/>
                        <field name="payment_type" widget="radio"/>
                    </group>
                </group>
                <group>
                    <field name="label"/>
                    <field name="transaction_type"/>
                    <field name="narration"/>
                </group>
                <footer>
                    <button string="Create Request" type="object" name="create_account_payment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>