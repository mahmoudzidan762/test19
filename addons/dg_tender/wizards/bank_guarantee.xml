<odoo>
    <record id="bank_guarantee_wizard_form_view" model="ir.ui.view">
        <field name="name">bank.guarantee.wizard.form.view</field>
        <field name="model">bank.guarantee</field>
        <field name="arch" type="xml">
            <form string="Bank Guarantee">
                <group>
                    <field name="guarantee_type" readonly="1"/>
                    <field name="project_value" readonly="1"/>
                    <field name="bank_guarantee_percent" readonly="1" widget="percentage"/>
                    <field name="bank_guarantee_value" readonly="1"/>
                    <field name="ref" readonly="1"/>
                    <field name="label"/>
                    <field name="narration"/>
                    <field name="payment_method"/>
                    <field name="journal_id"/>
                    <field name="commission_percent" widget="percentage"/>
                    <field name="commission_amount"/>
                </group>
                <footer>
                    <button string="Create Request" type="object" name="create_bank_guarantee" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>