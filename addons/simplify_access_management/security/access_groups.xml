<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_access_management" model="ir.module.category">
            <field name="name">Access Management</field>
            <field name="description">Configure the Simplify Access Management engine.</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_access_management" model="res.groups.privilege">
            <field name="name">Access Management</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_access_management"/>
        </record>

        <record id="group_access_management_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_access_management"/>
            <field name="comment">Users in this group can view, create, edit, archive and delete Access Rules. This group grants the right to CONFIGURE the Simplify Access Management engine; enforcement of the rules themselves is implemented in later development phases.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- System Administrators automatically manage Access Management,
             so that configuring it never depends on a second manually
             assigned group. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_access_management_manager'))]"/>
        </record>

    </data>
</odoo>
