<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_simplify_access_view_element_picker_form" model="ir.ui.view">
            <field name="name">simplify.access.view.element.picker.form</field>
            <field name="model">simplify.access.view.element.picker</field>
            <field name="arch" type="xml">
                <form string="Discover View Elements">
                    <field name="access_rule_id" invisible="1"/>
                    <field name="mode" invisible="1"/>
                    <group>
                        <field name="model_id"/>
                        <field name="model_name" invisible="1"/>
                        <field name="view_id" domain="[('model', '=', model_name)]"/>
                    </group>
                    <p class="text-muted" invisible="not view_id">
                        Select the elements to hide, then click "Add Selected".
                        Only elements with a stable technical name are shown.
                    </p>
                    <field name="candidate_ids" invisible="not view_id">
                        <list editable="bottom" create="0" delete="0">
                            <field name="element_type" column_invisible="1"/>
                            <field name="picker_id" column_invisible="1"/>
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="label"/>
                            <field name="technical_name"/>
                            <field name="technical_type" column_invisible="parent.mode != 'button'"/>
                        </list>
                    </field>
                    <footer>
                        <button name="action_add_selected" type="object"
                                string="Add Selected" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
